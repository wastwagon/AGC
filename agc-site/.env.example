# Production URL (for Open Graph, SEO)
NEXT_PUBLIC_SITE_URL=https://www.africagovernancecentre.org

# Optional: Social links (icons hidden until set)
# NEXT_PUBLIC_TWITTER_URL=https://twitter.com/africagovernance
# NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/africa-governance-centre
# NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/africagovernancecentre
# NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/africagovernancecentre

# Optional: Override default images (must be /uploads/ paths from media library)
# Upload images at /admin/media, then set paths here
# NEXT_PUBLIC_HERO_IMAGE=/uploads/hero.jpg
# NEXT_PUBLIC_ABOUT_IMAGE=/uploads/about.jpg
# NEXT_PUBLIC_PROGRAMS_IMAGE=/uploads/programs.jpg
# NEXT_PUBLIC_PROJECTS_IMAGE=/uploads/projects.jpg
# NEXT_PUBLIC_ADVISORY_IMAGE=/uploads/advisory.jpg
# NEXT_PUBLIC_EVENTS_IMAGE=/uploads/events.jpg
# NEXT_PUBLIC_NEWS_IMAGE=/uploads/news.jpg
# NEXT_PUBLIC_GET_INVOLVED_IMAGE=/uploads/get-involved.jpg
# NEXT_PUBLIC_CONTACT_IMAGE=/uploads/contact.jpg
# NEXT_PUBLIC_APP_SUMMIT_IMAGE=/uploads/app-summit.jpg
# NEXT_PUBLIC_APPLICATIONS_IMAGE=/uploads/applications.jpg

# Optional: Hero slider images (comma-separated /uploads/ paths)
# NEXT_PUBLIC_HERO_SLIDER_IMAGES=/uploads/hero.jpg,/uploads/slide2.jpg,/uploads/slide3.jpg

# Optional: Sentry error monitoring
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=agc-site

# Admin authentication (required for /admin/*)
AUTH_SECRET=  # Generate with: openssl rand -base64 32
ADMIN_EMAIL=admin@africagovernancecentre.org
ADMIN_PASSWORD=changeme

# Optional: Analytics (use one)
# Google Analytics 4:
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Plausible (privacy-friendly):
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# Public-site preview without Postgres (bundled fallbacks). /admin still requires DATABASE_URL.
# DEV_WITHOUT_DB=1

# Vercel + Supabase Storage (public media URLs; omit on Coolify/Docker)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET=media
# Server-only: required for admin media uploads on Vercel (Storage write access)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL — CMS, admin, forms (required for /admin data pages)
# Vercel: use Supabase Transaction pooler port 6543 + ?pgbouncer=true
# Prisma CLI (`npx prisma migrate deploy`) reads DATABASE_URL from `.env` in this folder, not from `.env.local`.
# Copy this file to `.env` and set a real URL, or export DATABASE_URL in your shell.
# Local Docker Compose (repo root: docker compose up -d agc-db) exposes Postgres on host port 5436 by default:
# DATABASE_URL="postgresql://agc:agc_secret@localhost:5436/agc?schema=public"
# Or use your own Postgres (any port):
DATABASE_URL="postgresql://user:password@localhost:5432/agc?schema=public"

# Resend - Email delivery for contact / newsletter / applications (unchanged)
# Get your API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# Optional: Custom Resend sender (must be verified in Resend)
# Default: onboarding@resend.dev
RESEND_FROM_EMAIL=programs@africagovernancecentre.org

# ---------------------------------------------------------------------------
# Registration of Interest (APPS / AYPF / AWPLS) — SMTP per event inbox
# Confirmation emails to applicants + staff notify use these settings (not Resend).
# Event-specific vars override shared ROI_SMTP_* defaults when both are set.
# ---------------------------------------------------------------------------

# Optional shared SMTP defaults (host/port/user/pass) for all three events:
# ROI_SMTP_HOST=mail.africagovernancecentre.org
# ROI_SMTP_PORT=587
# ROI_SMTP_SECURE=false
# ROI_SMTP_USER=
# ROI_SMTP_PASS=

# APPS → from appi@africagovernancecentre.org
SMTP_APPS_HOST=mail.africagovernancecentre.org
SMTP_APPS_PORT=587
SMTP_APPS_SECURE=false
SMTP_APPS_USER=appi@africagovernancecentre.org
SMTP_APPS_PASS=
SMTP_APPS_FROM=appi@africagovernancecentre.org

# AYPF → from aypf@africagovernancecentre.org
SMTP_AYPF_HOST=mail.africagovernancecentre.org
SMTP_AYPF_PORT=587
SMTP_AYPF_SECURE=false
SMTP_AYPF_USER=aypf@africagovernancecentre.org
SMTP_AYPF_PASS=
SMTP_AYPF_FROM=aypf@africagovernancecentre.org

# AWPLS → from awpls@africagovernancecentre.org
SMTP_AWPLS_HOST=mail.africagovernancecentre.org
SMTP_AWPLS_PORT=587
SMTP_AWPLS_SECURE=false
SMTP_AWPLS_USER=awpls@africagovernancecentre.org
SMTP_AWPLS_PASS=
SMTP_AWPLS_FROM=awpls@africagovernancecentre.org

# Paystack - Worldwide card donations (/donate)
# Live keys (production):
# PAYSTACK_SECRET_KEY=sk_live_xxxxxxxx
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxx
# Test keys (when Admin → Donation settings → Test mode is on):
# PAYSTACK_TEST_SECRET_KEY=sk_test_xxxxxxxx
# NEXT_PUBLIC_PAYSTACK_TEST_PUBLIC_KEY=pk_test_xxxxxxxx

# Optional: Override donate link (defaults to /donate)
# NEXT_PUBLIC_DONATE_HREF=/donate
